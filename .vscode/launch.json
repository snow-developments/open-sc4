  "version": "0.2.0",
  "configurations": [
    {
      "request": "launch",
      "name": "Open SimCity 4",
      "type": "node",
      "program": "${workspaceFolder}/clients/deno/main.ts",
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_BACKTRACE": "1"
      },
      "runtimeExecutable": "C:\\Users\\enigm\\.deno\\bin\\deno.EXE",
      "runtimeArgs": [
        "run",
        "--inspect-wait",
        "--allow-all",
        "--unstable-ffi",
        "--unstable-webgpu",
        "--allow-ffi",
        "--allow-read",
        "--allow-write",
        "--allow-env"
      ],
      "attachSimplePort": 9229
    }
  ]
}
